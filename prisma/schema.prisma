datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String // Password hash (bcrypt/argon2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AUSTRALIAN BANK DETAILS
  bankAccountName String?
  bankBsb         String?
  bankAccountNo   String?
  payId           String?

  timezone        String   @default("Australia/Perth")

  clients Client[]
}

model Client {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  phone        String
  email        String?
  address      String
  notes        String?
  defaultPrice Decimal

  // PAYMENT PREFERENCES
  preferredPaymentMethod PaymentMethod @default(BANK_TRANSFER)
  hourlyRate             Decimal       @default(50.00)

  // INDIVIDUAL TOGGLES AND PREFERENCES
  enableAppointmentReminder Boolean @default(true)
  reminderDaysBefore        Int     @default(1)

  enableInvoice   Boolean @default(true)
  autoSendInvoice Boolean @default(false)

  enablePaymentReminder Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  invoices     Invoice[]
}

model Appointment {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date   DateTime
  price  Decimal
  status AppointmentStatus @default(SCHEDULED)

  // Payment method recorded when completed (or chosen)
  paymentMethod   PaymentMethod?
  durationMinutes Int?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice?
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Invoice {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  invoiceNumber String        @unique
  amount        Decimal
  dueDate       DateTime
  status        PaymentStatus @default(PENDING)

  // SERVICE DETAILS SNAPSHOT
  durationMinutes Int?
  hourlyRate      Decimal?

  // SNAPSHOT OF BANK DETAILS CAPTURED AT TIME OF ISSUANCE
  paymentAccountName String?
  paymentBsb         String?
  paymentAccountNo   String?
  paymentPayId       String?

  sentAt       DateTime?
  lastChasedAt DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}
