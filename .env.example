# Database (PostgreSQL)
# For local Postgres: postgresql://postgres:postgres@localhost:5432/cleaner_manager
# For Supabase / Neon, provide pooled DATABASE_URL and DIRECT_URL for migrations
DATABASE_URL="postgresql://user:password@localhost:5432/cleaner_manager"
DIRECT_URL="postgresql://user:password@localhost:5432/cleaner_manager"

# Authentication (Custom JWT session via jose)
# Generate a secure 64+ char random string: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-length"

# Cron Job Security
# Secret token to authorize HTTP GET calls to /api/cron
CRON_SECRET="your-secure-cron-secret-token"

# Email Delivery (Resend)
# Required for sending appointment reminders and tax invoices
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Cleaning Management <onboarding@resend.dev>"

# Address Autocomplete (Google Places API)
# Optional: enables live Australian address lookup suggestions in forms
GOOGLE_PLACES_API_KEY="AIzaSyYourGooglePlacesAPIKeyHere"

# Registration Access Control (Optional)
# Comma-separated list of emails permitted to register. If empty or commented out, all registrations are allowed.
ALLOWED_REGISTRATION_EMAILS=""
